<Window x:Class="MiniProToolkit.App.FloatingStatusSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面悬浮窗设置"
        Width="660"
        Height="760"
        MinWidth="600"
        MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="{DynamicResource ObsidianWindowBackgroundBrush}"
        Foreground="{DynamicResource ObsidianTextPrimaryBrush}"
        FontFamily="{DynamicResource ObsidianFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 与任务栏/OSD 设置窗共用同一份深色皮肤；只在当前窗口合并，不写进全局 App 资源。 -->
                <ResourceDictionary Source="Themes/Obsidian.Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 棋盘格底纹：透明/半透明颜色叠在上面时能直接看出“这里是透明的”。 -->
            <DrawingBrush x:Key="FloatingColorCheckerBrush" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FF2A3542" Geometry="M0,0 H12 V12 H0 Z" />
                        <GeometryDrawing Brush="#FF1A2230">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,6,6" />
                                    <RectangleGeometry Rect="6,6,6,6" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText" AutomationProperties.Name="桌面悬浮窗设置验证结果"
                       Foreground="{StaticResource ObsidianDangerBrush}" VerticalAlignment="Center"
                       Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="320" />
            <Button AutomationProperties.Name="取消桌面悬浮窗设置修改" Content="取消" Click="CancelClick" IsCancel="True" Margin="0,0,6,0" />
            <Button AutomationProperties.Name="保存桌面悬浮窗设置" Content="保存" Click="SaveClick" IsDefault="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="桌面悬浮窗" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="独立于任务栏状态条：两者可以同时开启，也可以只开其中一个。这里只影响显示，不读写硬件，也不改变风扇、Guardian、EC/WMI 或 1 秒采样调度。位置靠拖动悬浮窗本身调整（对话框期间可实时拖动预览），锁定后不可拖动；显示器分辨率/DPI/拔插变化时窗口会被夹回当前工作区。"
                           Foreground="{StaticResource ObsidianTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />

                <CheckBox x:Name="EnabledCheck" Content="启用桌面悬浮窗（独立于任务栏状态条）"
                          Checked="PreviewChanged" Unchecked="PreviewChanged" Margin="0,0,0,8"
                          AutomationProperties.Name="启用桌面悬浮窗"
                          AutomationProperties.HelpText="默认关闭。勾选后立即预览显示，保存后写入 floating-status.json 并在下次启动时自动显示；取消勾选保存后隐藏，任务栏状态条不受影响。" />
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="CompactCheck" Content="紧凑（更小间距与字号）" Margin="0,0,18,0"
                              Checked="PreviewChanged" Unchecked="PreviewChanged"
                              AutomationProperties.Name="桌面悬浮窗紧凑显示"
                              AutomationProperties.HelpText="只影响悬浮窗的间距和字号，不替代排列模式。" />
                    <CheckBox x:Name="TopmostCheck" Content="总在最前" Margin="0,0,18,0"
                              Checked="PreviewChanged" Unchecked="PreviewChanged"
                              AutomationProperties.Name="桌面悬浮窗总在最前"
                              AutomationProperties.HelpText="开启时悬浮窗显示在普通窗口之上；关闭后会被其它窗口覆盖。保存后保留。" />
                    <CheckBox x:Name="LockedCheck" Content="锁定位置" Margin="0,0,18,0"
                              Checked="PreviewChanged" Unchecked="PreviewChanged"
                              AutomationProperties.Name="锁定桌面悬浮窗位置"
                              AutomationProperties.HelpText="锁定后拖动条不再移动悬浮窗，避免误拖；右键菜单也可以切换锁定。" />
                </WrapPanel>

                <TextBlock Text="显示项目与顺序" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,4" />
                <TextBlock Text="勾选决定是否在悬浮窗显示该项目；拖动每行左侧的手柄上下移动即可调整顺序（也可选中后按 Ctrl+↑ / Ctrl+↓ 微调），列表实时预览并随“保存”写入 floating-status.json。点击复选框只改变是否显示，不会移动项目。顺序与是否显示与任务栏的显示项互不影响。"
                           Foreground="{StaticResource ObsidianTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ListBox x:Name="ItemsList" Height="220" SelectionMode="Single" ScrollViewer.CanContentScroll="True"
                         PreviewKeyDown="ItemsListPreviewKeyDown"
                         AutomationProperties.Name="桌面悬浮窗显示项目与顺序"
                         AutomationProperties.HelpText="拖动每行左侧手柄上下移动可即时调整顺序（拖到列表边缘会自动滚动）；也可选中项目后按 Ctrl+↑ / Ctrl+↓ 一次移动一格。这里没有上移/下移按钮。拖动复选框只改变勾选，不会移动项目。">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 独立的拖拽手柄：只有这块区域会移动项目，复选框不受影响。 -->
                                <Thumb x:Name="ItemDragThumb" Width="18" Height="24" Cursor="SizeNS" Background="Transparent"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Focusable="False"
                                       AutomationProperties.Name="{Binding DragHandleName}"
                                       AutomationProperties.HelpText="按住此手柄上下拖动，实时调整该状态项目在桌面悬浮窗上的顺序。"
                                       DragStarted="ItemDragStarted" DragDelta="ItemDragDelta" DragCompleted="ItemDragCompleted">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" Padding="4,2">
                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Rectangle Width="10" Height="2" Fill="{DynamicResource ObsidianTextSecondaryBrush}" />
                                                    <Rectangle Width="10" Height="2" Fill="{DynamicResource ObsidianTextSecondaryBrush}" Margin="0,2,0,0" />
                                                    <Rectangle Width="10" Height="2" Fill="{DynamicResource ObsidianTextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayIndex}" VerticalAlignment="Center"
                                           Foreground="{StaticResource ObsidianTextSecondaryBrush}" FontSize="12" />
                                <CheckBox Grid.Column="2" AutomationProperties.Name="{Binding Label}"
                                          AutomationProperties.HelpText="勾选以在桌面悬浮窗显示此状态项目。"
                                          Content="{Binding Label}" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="排列模式" Margin="0,14,0,4" />
                <ComboBox x:Name="LayoutModeCombo" Width="380" HorizontalAlignment="Left"
                          SelectionChanged="LayoutModeChanged"
                          AutomationProperties.Name="桌面悬浮窗排列模式"
                          AutomationProperties.HelpText="与任务栏相同的四种排列：A 双列堆叠（默认）、C 单行分段、D 自适应多列、E 标签上数值下。C 的两组是“前 2 项 / 其余项目”。窗口内放不下时显示 +N（悬停可看被省略的指标），不会静默裁切。保存后保留。">
                    <ComboBoxItem Content="A · 双列堆叠（默认）" Tag="StackedPairs" />
                    <ComboBoxItem Content="C · 单行分段" Tag="Inline" />
                    <ComboBoxItem Content="D · 自适应多列" Tag="AdaptiveColumns" />
                    <ComboBoxItem Content="E · 标签上、数值下" Tag="LabelOverValue" />
                </ComboBox>
                <TextBlock x:Name="LayoutModeHint" AutomationProperties.Name="桌面悬浮窗排列模式说明"
                           Foreground="{StaticResource ObsidianTextSecondaryBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="字体" VerticalAlignment="Center" />
                    <TextBox x:Name="FontFamilyText" Grid.Column="1" MaxLength="100" TextChanged="DisplayTextChanged"
                             AutomationProperties.Name="桌面悬浮窗字体家族"
                             AutomationProperties.HelpText="输入本机已安装的字体家族名；无效名称会回退为 Segoe UI。" />
                    <TextBlock Text="字号" Grid.Row="1" VerticalAlignment="Center" />
                    <TextBox x:Name="FontSizeText" Grid.Row="1" Grid.Column="1" TextChanged="DisplayTextChanged"
                             AutomationProperties.Name="桌面悬浮窗字号"
                             AutomationProperties.HelpText="输入 8 到 32 之间的字号，只影响桌面悬浮窗。" />
                </Grid>

                <!-- 与任务栏设置共用的“单一配色卡”语义：先选文字/背景目标，再用同一组色样、
                     同一个“更多颜色…”和同一个高级色号修改它；背景目标额外有不透明度和完全透明。
                     所有编辑只改内存值并即时预览，保存才写入 floating-status.json。 -->
                <Border x:Name="ColorCard" Margin="0,14,0,0" Padding="14" CornerRadius="10"
                        Background="{StaticResource ObsidianCardBackgroundBrush}"
                        BorderBrush="{StaticResource ObsidianCardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="悬浮窗配色" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="选择文字或背景后挑色，即时预览；保存后保留。与任务栏配色完全独立。"
                                   Foreground="{StaticResource ObsidianTextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton x:Name="TextColorTargetRadio" GroupName="FloatingColorTarget" IsChecked="True"
                                         Checked="ColorTargetChanged" Margin="0,0,18,0" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="悬浮窗颜色编辑目标：文字"
                                         AutomationProperties.HelpText="选中后，色样、“更多颜色…”和高级色号都只修改悬浮窗文字颜色；切换目标不会改动任何已选颜色。">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="18" Height="18">
                                        <Border CornerRadius="3" Background="{StaticResource FloatingColorCheckerBrush}"
                                                BorderBrush="{StaticResource ObsidianControlBorderBrush}" BorderThickness="1" />
                                        <Border x:Name="TextColorChip" CornerRadius="3" Background="#E8EAED" />
                                    </Grid>
                                    <TextBlock Text="文字" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="BackgroundColorTargetRadio" GroupName="FloatingColorTarget"
                                         Checked="ColorTargetChanged" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="悬浮窗颜色编辑目标：背景"
                                         AutomationProperties.HelpText="选中后，色样、“更多颜色…”和高级色号都只修改悬浮窗背景颜色并保留它已有的不透明度；切换目标不会改动任何已选颜色。">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="18" Height="18">
                                        <Border CornerRadius="3" Background="{StaticResource FloatingColorCheckerBrush}"
                                                BorderBrush="{StaticResource ObsidianControlBorderBrush}" BorderThickness="1" />
                                        <Border x:Name="BackgroundColorChip" CornerRadius="3" Background="#CC1E2228" />
                                    </Grid>
                                    <TextBlock Text="背景" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <TextBlock x:Name="ColorTargetStatusText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                   AutomationProperties.Name="当前悬浮窗颜色编辑目标与色值" />

                        <TextBlock Text="配色预览" FontSize="11" Margin="0,12,0,4"
                                   Foreground="{StaticResource ObsidianTextSecondaryBrush}" />
                        <Border x:Name="ColorPreviewSurface" Height="44" CornerRadius="8" Padding="10"
                                Background="{StaticResource FloatingColorCheckerBrush}"
                                BorderBrush="{StaticResource ObsidianCardBorderBrush}" BorderThickness="1"
                                AutomationProperties.Name="悬浮窗配色预览（棋盘格表示透明）">
                            <Border x:Name="ColorPreviewCard" CornerRadius="5" Padding="10,4"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Background="#CC1E2228">
                                <TextBlock x:Name="ColorPreviewText" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED"
                                           Text="CPU · 风扇 · 功耗"
                                           AutomationProperties.Name="悬浮窗配色预览文字示例" />
                            </Border>
                        </Border>

                        <WrapPanel x:Name="ColorSwatches" Margin="0,12,0,0" Orientation="Horizontal"
                                   AutomationProperties.Name="悬浮窗颜色常用色样"
                                   AutomationProperties.HelpText="色样修改当前选中的编辑目标；每个色样是可聚焦按钮，悬停提示包含中文色名和十六进制色值。">
                            <Button Tag="#000000" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="黑色 #000000" AutomationProperties.Name="悬浮窗文字/背景色样 黑色 #000000">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#000000" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#FFFFFF" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="白色 #FFFFFF" AutomationProperties.Name="悬浮窗文字/背景色样 白色 #FFFFFF">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#808080" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="灰色 #808080" AutomationProperties.Name="悬浮窗文字/背景色样 灰色 #808080">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#808080" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#FF5C5C" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="红色 #FF5C5C" AutomationProperties.Name="悬浮窗文字/背景色样 红色 #FF5C5C">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#FF5C5C" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#FFB86B" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="橙色 #FFB86B" AutomationProperties.Name="悬浮窗文字/背景色样 橙色 #FFB86B">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#FFB86B" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#FFE082" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="黄色 #FFE082" AutomationProperties.Name="悬浮窗文字/背景色样 黄色 #FFE082">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#FFE082" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#7AE582" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="绿色 #7AE582" AutomationProperties.Name="悬浮窗文字/背景色样 绿色 #7AE582">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#7AE582" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#69DBCF" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="青色 #69DBCF" AutomationProperties.Name="悬浮窗文字/背景色样 青色 #69DBCF">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#69DBCF" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#70D6FF" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="蓝色 #70D6FF" AutomationProperties.Name="悬浮窗文字/背景色样 蓝色 #70D6FF">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#70D6FF" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#C792EA" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="紫色 #C792EA" AutomationProperties.Name="悬浮窗文字/背景色样 紫色 #C792EA">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#C792EA" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#D9E0E8" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="银灰 #D9E0E8" AutomationProperties.Name="悬浮窗文字/背景色样 银灰 #D9E0E8">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#D9E0E8" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                            <Button Tag="#FF8FB1" Width="34" Height="30" Padding="0" Margin="0,0,6,6" Click="ColorSwatchClick" ToolTip="粉色 #FF8FB1" AutomationProperties.Name="悬浮窗文字/背景色样 粉色 #FF8FB1">
                                <Border Width="22" Height="22" CornerRadius="3" Background="#FF8FB1" BorderBrush="#66FFFFFF" BorderThickness="1" />
                            </Button>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                            <Button x:Name="MoreColorsButton" Content="更多颜色…" Click="MoreColorsClick" Margin="0,0,10,0"
                                    AutomationProperties.Name="用系统调色盘为当前悬浮窗编辑目标选择更多颜色"
                                    AutomationProperties.HelpText="打开 Windows 颜色对话框为当前选中的文字或背景选择颜色；只修改当前目标并保留它已有的不透明度，取消不会改动任何颜色。" />
                            <TextBlock x:Name="ColorCustomHint" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                       AutomationProperties.Name="当前悬浮窗颜色不在预设中的提示" />
                        </StackPanel>

                        <StackPanel x:Name="BackgroundOpacityPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="不透明度" VerticalAlignment="Center" />
                                <Slider x:Name="BackgroundOpacitySlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100"
                                        TickFrequency="1" IsSnapToTickEnabled="True" Value="80" ValueChanged="BackgroundOpacityChanged"
                                        AutomationProperties.Name="桌面悬浮窗背景不透明度百分比"
                                        AutomationProperties.HelpText="0 表示背景全透明，100 表示完全不透明；只影响背景，不改文字颜色。拖动后即时预览，保存后保留。" />
                                <TextBlock x:Name="BackgroundOpacityText" Grid.Column="2" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                           AutomationProperties.Name="桌面悬浮窗背景当前不透明度" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <Button x:Name="BackgroundTransparentButton" Content="完全透明" Click="BackgroundTransparentClick" Margin="0,0,10,0"
                                        AutomationProperties.Name="把桌面悬浮窗背景设为完全透明"
                                        AutomationProperties.HelpText="把背景写成 #00000000；会记住最近选择的背景颜色，之后调高不透明度即可恢复。" />
                                <TextBlock x:Name="BackgroundOpacityHint" Visibility="Collapsed" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                           Text="背景当前全透明，调高不透明度后可见。"
                                           AutomationProperties.Name="悬浮窗背景全透明提示" />
                            </StackPanel>
                        </StackPanel>

                        <Expander x:Name="AdvancedColorExpander" Header="高级：色号" IsExpanded="False" Margin="0,12,0,0"
                                  AutomationProperties.Name="桌面悬浮窗高级色号输入"
                                  AutomationProperties.HelpText="默认折叠；展开后可输入 #RRGGBB 或 #AARRGGBB，只修改当前编辑目标。回车或离开输入框生效，非法色号会就地提示且不会保存。">
                            <StackPanel>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                           Text="当前目标的十六进制色号（#RRGGBB 或 #AARRGGBB）；回车或离开输入框生效，Esc 恢复为已提交的颜色。" />
                                <TextBox x:Name="AdvancedColorText" LostFocus="AdvancedColorTextLostFocus" KeyDown="AdvancedColorTextKeyDown"
                                         AutomationProperties.Name="桌面悬浮窗当前编辑目标的十六进制色号"
                                         AutomationProperties.HelpText="只对应上面选中的文字或背景目标；回车或离开输入框提交。非法值就地提示，不写入设置也不预览。按 Esc 恢复为已提交的颜色。" />
                                <TextBlock x:Name="AdvancedColorErrorText" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="#FFFF7B8A"
                                           AutomationProperties.Name="悬浮窗高级色号错误提示" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <TextBlock Text="鼠标交互" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,4" />
                <CheckBox x:Name="ClickThroughCheck" Content="鼠标穿透（点击直接穿过悬浮窗）"
                          Checked="PreviewChanged" Unchecked="PreviewChanged" Margin="0,0,0,4"
                          AutomationProperties.Name="桌面悬浮窗鼠标穿透"
                          AutomationProperties.HelpText="默认关闭。开启并保存后，鼠标点击会直接穿过悬浮窗，卡片本身不再接收点击；关闭请用托盘菜单“关闭悬浮窗鼠标穿透”、主窗口“关闭穿透”按钮或全局快捷键（默认 Ctrl+Alt+F10），这些入口都不需要悬浮窗收到鼠标。编辑本设置期间穿透会暂时暂停。" />
                <TextBlock Text="编辑期间暂停穿透；关闭设置后按选项恢复。开启穿透后悬浮窗的右键菜单不再可用，请改用托盘、主窗口按钮或全局快捷键关闭。"
                           Foreground="{StaticResource ObsidianTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           AutomationProperties.Name="桌面悬浮窗鼠标穿透安全说明" />
                <CheckBox x:Name="SnapToEdgesCheck" Content="拖动结束后靠边吸附（12 DIP 内贴边，默认开启）"
                          Checked="PreviewChanged" Unchecked="PreviewChanged" Margin="0,0,0,4"
                          AutomationProperties.Name="桌面悬浮窗靠边吸附"
                          AutomationProperties.HelpText="默认开启。拖动结束且松手位置距工作区上下左右边 12 DIP 以内时贴边（0 间隙），可同时贴两个边；只在拖动结束时生效，刷新、缩放和 DPI 变化不会移动窗口。关闭后拖动结束只保留“不超出工作区”的夹回。" />

                <TextBlock Text="位置" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,4" />
                <TextBlock Text="位置靠拖动悬浮窗调整：本对话框打开时可以实时拖动预览。保存后记住当前显示器与相对工作区的位置；取消会恢复到打开对话框前的位置。锁定位置后拖动条不再移动窗口。"
                           Foreground="{StaticResource ObsidianTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock x:Name="PositionStatusText" AutomationProperties.Name="桌面悬浮窗当前位置"
                           Foreground="{StaticResource ObsidianTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                <Button x:Name="ResetPositionButton" Content="恢复默认位置（主屏工作区右下角）"
                        HorizontalAlignment="Left" Margin="0,4,0,0" Click="ResetPositionClick"
                        AutomationProperties.Name="恢复桌面悬浮窗默认位置"
                        AutomationProperties.HelpText="只清除已记住的显示器和相对位置，即时预览回主屏工作区右下角（16 DIP 边距）；保存后生效，取消则恢复打开时的位置。不会强制启用悬浮窗，也不改动颜色、显示项、字号、锁定和总在最前。" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
