<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        方案 A「曜石控制舱」展示层主题。
        只做视觉：颜色、字号、圆角、间距、控件模板状态。所有资源统一 Obsidian 前缀，
        默认只在 MainWindow 的 Window.Resources 里合并，不改 OSD / 任务栏 overlay 的既有外观偏好。
    -->

    <!-- ===== 基础色 ===== -->
    <SolidColorBrush x:Key="ObsidianWindowBackgroundBrush" Color="#0B1018" />
    <SolidColorBrush x:Key="ObsidianSidebarBackgroundBrush" Color="#0D1521" />
    <SolidColorBrush x:Key="ObsidianTopBarBackgroundBrush" Color="#0C1320" />
    <SolidColorBrush x:Key="ObsidianCardBackgroundBrush" Color="#101A28" />
    <SolidColorBrush x:Key="ObsidianCardBorderBrush" Color="#223044" />
    <SolidColorBrush x:Key="ObsidianSidebarBorderBrush" Color="#1C2939" />
    <SolidColorBrush x:Key="ObsidianDividerBrush" Color="#1A2433" />

    <SolidColorBrush x:Key="ObsidianTextPrimaryBrush" Color="#E5EDF7" />
    <SolidColorBrush x:Key="ObsidianTextSecondaryBrush" Color="#98ABC0" />
    <SolidColorBrush x:Key="ObsidianTextTertiaryBrush" Color="#7C8FA6" />

    <SolidColorBrush x:Key="ObsidianAccentBrush" Color="#66DEC4" />
    <SolidColorBrush x:Key="ObsidianAccentHoverBrush" Color="#8CEBD7" />
    <SolidColorBrush x:Key="ObsidianAccentPressedBrush" Color="#4CC5AB" />
    <SolidColorBrush x:Key="ObsidianAccentInkBrush" Color="#04120F" />
    <SolidColorBrush x:Key="ObsidianAccentSoftBrush" Color="#1A66DEC4" />
    <SolidColorBrush x:Key="ObsidianWarningBrush" Color="#EDBA68" />
    <SolidColorBrush x:Key="ObsidianDangerBrush" Color="#F08A7C" />
    <SolidColorBrush x:Key="ObsidianDangerSoftBrush" Color="#26F08A7C" />

    <SolidColorBrush x:Key="ObsidianControlBackgroundBrush" Color="#14202E" />
    <SolidColorBrush x:Key="ObsidianControlHoverBrush" Color="#1B2A3A" />
    <SolidColorBrush x:Key="ObsidianControlPressedBrush" Color="#0F1926" />
    <SolidColorBrush x:Key="ObsidianControlBorderBrush" Color="#24323F" />
    <SolidColorBrush x:Key="ObsidianControlHoverBorderBrush" Color="#33506B" />
    <SolidColorBrush x:Key="ObsidianControlTextBrush" Color="#D6E2EE" />
    <SolidColorBrush x:Key="ObsidianControlDisabledBackgroundBrush" Color="#0E1620" />
    <SolidColorBrush x:Key="ObsidianControlDisabledTextBrush" Color="#5B6B7D" />
    <SolidColorBrush x:Key="ObsidianControlDisabledBorderBrush" Color="#1B2836" />

    <SolidColorBrush x:Key="ObsidianNavHoverBrush" Color="#15202E" />
    <SolidColorBrush x:Key="ObsidianNavActiveBrush" Color="#152331" />
    <SolidColorBrush x:Key="ObsidianModeActiveBackgroundBrush" Color="#1C2C3D" />

    <SolidColorBrush x:Key="ObsidianPillBackgroundBrush" Color="#0E1826" />
    <SolidColorBrush x:Key="ObsidianPillBorderBrush" Color="#1E2B3A" />

    <SolidColorBrush x:Key="ObsidianMenuBackgroundBrush" Color="#0F1A27" />
    <SolidColorBrush x:Key="ObsidianMenuBorderBrush" Color="#24323F" />

    <SolidColorBrush x:Key="ObsidianFocusBrush" Color="#7FE7D2" />
    <SolidColorBrush x:Key="ObsidianScrollTrackBrush" Color="#0C1521" />
    <SolidColorBrush x:Key="ObsidianScrollThumbBrush" Color="#26374A" />
    <SolidColorBrush x:Key="ObsidianScrollThumbHoverBrush" Color="#35506B" />

    <!-- 趋势图线色：与 TrendLegendText 的 Run 颜色、code-behind 绘制一一对应 -->
    <SolidColorBrush x:Key="ObsidianChartTemperatureBrush" Color="#66DEC4" />
    <SolidColorBrush x:Key="ObsidianChartRpmBrush" Color="#7FA7FF" />
    <SolidColorBrush x:Key="ObsidianChartTargetRpmBrush" Color="#5E7791" />
    <SolidColorBrush x:Key="ObsidianChartDutyBrush" Color="#C792EA" />
    <SolidColorBrush x:Key="ObsidianChartPowerBrush" Color="#F0A868" />
    <SolidColorBrush x:Key="ObsidianChartGuideBrush" Color="#1B2634" />
    <SolidColorBrush x:Key="ObsidianChartBackgroundBrush" Color="#0D1622" />

    <!-- ===== 字号 / 字体 / 间距 ===== -->
    <sys:Double x:Key="ObsidianFontSizeCaption">12</sys:Double>
    <sys:Double x:Key="ObsidianFontSizeBody">13</sys:Double>
    <sys:Double x:Key="ObsidianFontSizeSection">14</sys:Double>
    <sys:Double x:Key="ObsidianFontSizeMetric">22</sys:Double>
    <sys:Double x:Key="ObsidianFontSizeDisplay">42</sys:Double>

    <FontFamily x:Key="ObsidianFontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif</FontFamily>
    <FontFamily x:Key="ObsidianNumericFontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif</FontFamily>

    <Thickness x:Key="ObsidianCardPadding">14</Thickness>
    <Thickness x:Key="ObsidianGapMargin">0,0,12,12</Thickness>

    <!-- ===== 焦点键盘态 ===== -->
    <Style x:Key="ObsidianFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="4" RadiusY="4" SnapsToDevicePixels="True"
                               Stroke="{StaticResource ObsidianFocusBrush}" StrokeThickness="1.6"
                               StrokeDashArray="2 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 卡片 / 文本 ===== -->
    <Style x:Key="ObsidianCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ObsidianCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="{StaticResource ObsidianCardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ObsidianSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ObsidianSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ObsidianCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ObsidianSecondaryTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextTertiaryBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="ObsidianMetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ObsidianMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeMetric}" />
        <Setter Property="FontFamily" Value="{StaticResource ObsidianNumericFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="ObsidianDisplayValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeDisplay}" />
        <Setter Property="FontFamily" Value="{StaticResource ObsidianNumericFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianAccentBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="ObsidianPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ObsidianPillBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianPillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===== Button ===== -->
    <Style x:Key="ObsidianButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ObsidianControlTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ObsidianControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeBody}" />
        <Setter Property="FontFamily" Value="{StaticResource ObsidianFontFamily}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ObsidianFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ObsidianControlHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianControlHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ObsidianControlPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ObsidianControlDisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ObsidianControlDisabledTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianControlDisabledBorderBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ObsidianPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ObsidianButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ObsidianAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianAccentInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ObsidianAccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ObsidianAccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ObsidianControlDisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ObsidianControlDisabledTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianControlDisabledBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ObsidianDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ObsidianButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ObsidianDangerSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianDangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ObsidianDangerBrush}" />
                <Setter Property="Foreground" Value="#160A08" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#D9756A" />
                <Setter Property="Foreground" Value="#160A08" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ObsidianControlDisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ObsidianControlDisabledTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianControlDisabledBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 侧栏导航项：选中态只由 Tag=active 表示，不假装硬件状态 -->
    <Style x:Key="ObsidianNavButtonStyle" TargetType="Button" BasedOn="{StaticResource ObsidianButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinHeight" Value="34" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ObsidianNavHoverBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ObsidianControlPressedBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="active">
                <Setter Property="Background" Value="{StaticResource ObsidianNavActiveBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ObsidianAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource ObsidianControlDisabledTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 分段控件（性能模式）：选中态同样只来自 Tag=active（由 snapshot 驱动） -->
    <Style x:Key="ObsidianSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource ObsidianButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextSecondaryBrush}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="84" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ObsidianControlHoverBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ObsidianControlPressedBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="active">
                <Setter Property="Background" Value="{StaticResource ObsidianModeActiveBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ObsidianAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource ObsidianControlDisabledTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style x:Key="ObsidianComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ObsidianControlTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeBody}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ObsidianFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" CornerRadius="6" Margin="3,1" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ObsidianControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ObsidianAccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ObsidianAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ObsidianControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ObsidianComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource ObsidianControlTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ObsidianControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeBody}" />
        <Setter Property="FontFamily" Value="{StaticResource ObsidianFontFamily}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ObsidianFocusVisualStyle}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ObsidianComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Chrome" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <!-- 透明命中层放在内容下面：内容为空白的区域点击/滚轮落到这里，
                             可编辑文本框自身在最上层，鼠标选中与光标不被抢。 -->
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="SelectionContent" Grid.Column="0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{StaticResource ObsidianAccentBrush}"
                                     SelectionBrush="{StaticResource ObsidianAccentSoftBrush}"
                                     FontSize="{TemplateBinding FontSize}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     VerticalAlignment="Center"
                                     IsHitTestVisible="True"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Path x:Name="Arrow" Grid.Column="1" Margin="8,1,0,0" VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Data="M 0,0 L 4,4.5 L 8,0" Stroke="{StaticResource ObsidianTextSecondaryBrush}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource ObsidianMenuBackgroundBrush}"
                                    BorderBrush="{StaticResource ObsidianMenuBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer MaxHeight="240" Style="{DynamicResource ObsidianScrollViewerStyle}"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" Margin="0,3" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ObsidianControlHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ObsidianControlDisabledBackgroundBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ObsidianControlDisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ObsidianControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox ===== -->
    <Style x:Key="ObsidianCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ObsidianControlTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeBody}" />
        <Setter Property="FontFamily" Value="{StaticResource ObsidianFontFamily}" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ObsidianFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="4" Background="{StaticResource ObsidianControlBackgroundBrush}"
                                    BorderBrush="{StaticResource ObsidianControlBorderBrush}" BorderThickness="1" />
                            <Path x:Name="CheckMark" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 3,7 L 6.4,10.4 L 12.6,3.6" Stroke="{StaticResource ObsidianAccentInkBrush}"
                                  StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource ObsidianAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ObsidianAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ObsidianFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ObsidianControlDisabledTextBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource ObsidianControlDisabledBackgroundBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ObsidianControlDisabledBorderBrush}" />
                            <Setter TargetName="CheckMark" Property="Stroke" Value="{StaticResource ObsidianControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollViewer / ScrollBar ===== -->
    <Style x:Key="ObsidianInvisibleRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ObsidianScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbChrome" CornerRadius="4" Margin="2"
                            Background="{StaticResource ObsidianScrollThumbBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource ObsidianScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource ObsidianAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ObsidianScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="{StaticResource ObsidianScrollTrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ObsidianInvisibleRepeatButtonStyle}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ObsidianScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ObsidianInvisibleRepeatButtonStyle}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ObsidianScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical"
                                   Style="{StaticResource ObsidianScrollBarStyle}"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                   Style="{StaticResource ObsidianScrollBarStyle}"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Expander ===== -->
    <Style x:Key="ObsidianExpanderHeaderStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ObsidianFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Chevron" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                  Data="M 0,0 L 4,4.5 L 0,9" Stroke="{StaticResource ObsidianTextSecondaryBrush}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Data" Value="M 0,0 L 4.5,4.5 L 9,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource ObsidianAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ObsidianFocusBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ObsidianExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Focusable="True"
                                      Style="{StaticResource ObsidianExpanderHeaderStyle}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}" />
                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,8,0,0"
                                          Focusable="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ProgressBar（温度条，纯展示） ===== -->
    <Style x:Key="ObsidianProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="#0C1420" />
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ToolTip ===== -->
    <Style x:Key="ObsidianToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource ObsidianMenuBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ObsidianTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="{StaticResource ObsidianFontSizeCaption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" MaxWidth="420">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
