<Window x:Class="MiniProToolkit.App.FanProfileManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="方案管理" Width="820" Height="540" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner" Background="{DynamicResource ObsidianWindowBackgroundBrush}"
        Foreground="{DynamicResource ObsidianTextPrimaryBrush}"
        FontFamily="{DynamicResource ObsidianFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 方案 A「曜石控制舱」共用皮肤：基础色 + 键控样式 + 仅在本窗口生效的隐式控件样式。
                     只在当前窗口合并，不写进 App.xaml 全局资源，避免污染 OSD / 任务栏 overlay 的用户自定义视觉。 -->
                <ResourceDictionary Source="Themes/Obsidian.Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <TextBlock Text="方案管理" FontSize="22" FontWeight="SemiBold" />
   <TextBlock Text="编辑后点“保存当前修改”。保存全部只保存配置；保存并应用会切换硬件。取消丢弃本窗口草稿。" TextWrapping="Wrap" Foreground="{StaticResource ObsidianTextSecondaryBrush}" Margin="0,5,0,0" />
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="FeedbackText" Foreground="{StaticResource ObsidianTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8" />
   <WrapPanel HorizontalAlignment="Right">
    <Button Content="导入 JSON" Click="ImportClick" />
    <Button Content="导出全部" Click="ExportClick" />
    <Button Content="恢复内置方案" Click="ResetClick" />
    <Button Content="取消" IsCancel="True" />
    <Button Content="保存全部" Click="SaveClick" />
    <Button Content="保存并应用所选" Click="ApplyClick" />
   </WrapPanel>
  </StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,16,0">
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
     <Button Content="新建" Click="NewClick"/><Button Content="复制" Click="CopyClick"/><Button Content="删除" Click="DeleteClick"/>
    </WrapPanel>
    <ListBox x:Name="ProfilesList" SelectionChanged="SelectionChanged">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource ObsidianTextSecondaryBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <StackPanel Grid.Column="1">
    <TextBlock Text="名称（修改名称即重命名）"/><TextBox x:Name="NameBox" Margin="0,4,0,12"/>
    <TextBlock Text="性能模式"/><ComboBox x:Name="PowerCombo" SelectedIndex="0" Margin="0,4,0,12">
     <ComboBoxItem Content="均衡"/><ComboBoxItem Content="性能"/><ComboBoxItem Content="静音"/>
    </ComboBox>
    <TextBlock Text="风扇模式"/><ComboBox x:Name="FanCombo" SelectedIndex="0" Margin="0,4,0,12">
     <ComboBoxItem Content="EC 自动"/><ComboBoxItem Content="固定 RPM"/><ComboBoxItem Content="安全曲线"/><ComboBoxItem Content="满速"/>
    </ComboBox>
    <TextBlock Text="固定 RPM 目标（仅固定 RPM 模式使用）"/><TextBox x:Name="RpmBox" Text="2500" Margin="0,4,0,10"/>
    <TextBlock x:Name="CurveText" Foreground="{StaticResource ObsidianTextSecondaryBrush}" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,8,0,0"><Button Content="编辑此方案曲线" Click="CurveClick"/><Button Content="保存当前修改" Click="CommitClick"/></WrapPanel>
   </StackPanel>
  </Grid>
 </DockPanel>
</Window>
