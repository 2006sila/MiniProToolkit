<Window x:Class="MiniProToolkit.App.OsdSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD 外观与事件模板设置"
        Width="640"
        Height="700"
        MinWidth="600"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText" AutomationProperties.Name="OSD 设置验证结果" Foreground="#C62828" VerticalAlignment="Center"
                       Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="320" />
            <Button AutomationProperties.Name="恢复全部 OSD 设置默认值" Content="恢复默认" Click="RestoreDefaultsClick" Margin="0,0,6,0" />
            <Button AutomationProperties.Name="取消 OSD 设置修改" Content="取消" Click="CancelClick" Margin="0,0,6,0" />
            <Button x:Name="SaveButton" AutomationProperties.Name="保存 OSD 设置" Content="保存" Click="SaveClick" IsDefault="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="OSD 外观设置" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="只影响弹窗显示：颜色、字体、透明度、字号和位置都会保存到 osd.json，不读写硬件，也不影响风扇控制、Guardian 或采样。"
                           Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="前景色（文字）" VerticalAlignment="Center" />
                    <ComboBox x:Name="ForegroundCombo" AutomationProperties.Name="OSD 文字前景色预设" Grid.Column="1" HorizontalAlignment="Stretch"
                              SelectionChanged="ColorPresetChanged" />
                    <TextBox x:Name="ForegroundTextBox" AutomationProperties.Name="OSD 文字前景色自定义值" AutomationProperties.HelpText="输入 #RRGGBB 或 #AARRGGBB；留空跟随主题。" Grid.Column="3" MaxLength="9" VerticalAlignment="Center"
                             TextChanged="ColorTextChanged" />
                    <TextBlock x:Name="ForegroundErrorText" AutomationProperties.Name="前景色验证结果" Grid.Column="4" Foreground="#C62828" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0" />

                    <TextBlock Text="背景色" Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <ComboBox x:Name="BackgroundCombo" AutomationProperties.Name="OSD 背景色预设" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              Margin="0,10,0,0" SelectionChanged="ColorPresetChanged" />
                    <TextBox x:Name="BackgroundTextBox" AutomationProperties.Name="OSD 背景色自定义值" AutomationProperties.HelpText="输入 #RRGGBB 或 #AARRGGBB；留空跟随主题。" Grid.Row="1" Grid.Column="3" MaxLength="9"
                             VerticalAlignment="Center" Margin="0,10,0,0" TextChanged="ColorTextChanged" />
                    <TextBlock x:Name="BackgroundErrorText" AutomationProperties.Name="背景色验证结果" Grid.Row="1" Grid.Column="4" Foreground="#C62828" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,10,0,0" />

                    <TextBlock Text="背景不透明度" Grid.Row="2" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,12,0,0">
                        <Slider x:Name="OpacitySlider" AutomationProperties.Name="OSD 背景不透明度" AutomationProperties.HelpText="范围 0.2 到 1，步长 0.05。" Width="240" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="OpacityChanged" />
                        <TextBlock x:Name="OpacityText" AutomationProperties.Name="当前背景不透明度" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="字号" Grid.Row="3" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <ComboBox x:Name="FontSizeCombo" AutomationProperties.Name="OSD 字号" AutomationProperties.HelpText="字号范围 12 到 40。" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                              HorizontalAlignment="Left" Width="300" Margin="0,12,0,0" SelectionChanged="SelectionChanged" />

                    <TextBlock Text="字体家族" Grid.Row="4" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <TextBox x:Name="FontFamilyTextBox" AutomationProperties.Name="OSD 字体家族" AutomationProperties.HelpText="输入本机已安装的字体名；留空跟随主题，未安装的字体回退默认字体。" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                             MaxLength="64" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock x:Name="FontFamilyHint" AutomationProperties.Name="字体家族验证提示" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,12,0,0" />

                    <TextBlock Text="屏幕位置" Grid.Row="5" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <ComboBox x:Name="PlacementCombo" AutomationProperties.Name="OSD 屏幕位置" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                              HorizontalAlignment="Left" Width="300" Margin="0,12,0,0" SelectionChanged="SelectionChanged" />
                </Grid>
                <GroupBox Header="事件模板（纯文本，仅影响显示）" Margin="0,18,0,0">
                    <StackPanel Margin="10">
                        <ComboBox x:Name="EventCombo" AutomationProperties.Name="OSD 模板事件" AutomationProperties.HelpText="选择要编辑显示模板的事件；不会触发事件。" SelectionChanged="EventChanged" />
                        <CheckBox x:Name="TemplateOverrideCheck" AutomationProperties.Name="使用事件自定义模板" AutomationProperties.HelpText="不勾选表示保持原事件输出，不是关闭事件。" Content="使用自定义模板（不勾选＝保持原事件输出，不是关闭事件）"
                                  Margin="0,10,0,6" Click="TemplateOverrideChanged" />
                        <TextBlock x:Name="TemplateSafetyText" AutomationProperties.Name="事件模板安全限制说明" Foreground="#B26A00" TextWrapping="Wrap" />
                        <StackPanel x:Name="TemplateFields">
                            <TextBlock Text="标题（留空跟随事件）" Margin="0,8,0,2" />
                            <TextBox x:Name="TemplateTitleText" AutomationProperties.Name="事件模板标题" AutomationProperties.HelpText="最多 80 字；留空跟随事件，安全事件标题不可覆盖。" MaxLength="80" />
                            <CheckBox x:Name="TemplateBodyCheck" AutomationProperties.Name="显示事件原正文" AutomationProperties.HelpText="安全事件强制保留原正文。" Content="显示原正文（安全事件强制保留）" Margin="0,8,0,4" />
                            <TextBlock Text="额外静态说明（最多 120 字，敏感信息自动脱敏）" />
                            <TextBox x:Name="TemplateAdditionalText" AutomationProperties.Name="事件模板额外静态说明" AutomationProperties.HelpText="最多 120 字，敏感信息自动脱敏；不支持变量、脚本或 URI 加载。" MaxLength="120" Margin="0,2,0,6" />
                            <TextBlock Text="内置图标" />
                            <ComboBox x:Name="TemplateIconCombo" AutomationProperties.Name="事件模板内置图标" AutomationProperties.HelpText="安全事件图标不可覆盖。" Margin="0,2,0,6" />
                            <TextBlock Text="显示秒数（1–30；安全事件不会短于原始时长）" />
                            <ComboBox x:Name="TemplateDurationCombo" AutomationProperties.Name="事件模板显示时长秒数" AutomationProperties.HelpText="范围 1 到 30 秒；安全事件不会短于原始时长。" Margin="0,2,0,6" />
                        </StackPanel>
                        <Button AutomationProperties.Name="恢复所选事件模板默认值" Content="恢复此事件默认" Click="RestoreEventDefaultsClick" HorizontalAlignment="Left" />
                        <TextBlock Text="不支持变量、表达式、脚本、文件或 URI 加载。安全事件的标题、正文、图标和严重度不可覆盖；说明会标为“自定义说明”。保存全部修改后生效，取消不改变当前设置。"
                                   TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>
                <TextBlock x:Name="SummaryText" AutomationProperties.Name="OSD 设置摘要" Foreground="#333" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock Text="颜色：下拉里是常用预设，也可以直接输入任意颜色，必须是 #RRGGBB 或 #AARRGGBB（长度受限，非法值无法保存）；留空＝跟随主题。字体家族：可直接输入本机已安装的任意字体名，留空＝跟随主题；名称不合法会立即提示，名称合法但本机未安装时保存后弹窗自动回退默认字体。字号 12–40，位置 9 宫格。这些自定义会叠加在主题之上，切换主题不会重置它们。"
                           Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
