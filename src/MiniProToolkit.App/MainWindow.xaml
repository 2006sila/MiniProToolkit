<Window x:Class="MiniProToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniProToolkit"
        Width="1080"
        Height="700"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="恢复 EC 自动" Click="RestoreAutomaticClick" />
            <Button Content="满速" Click="FullSpeedClick" />
            <Button Content="退出" Click="ExitClick" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="历史" Click="HistoryClick" Margin="0,0,8,0" />
                    <Button Content="诊断" Click="DiagnosticsClick" Margin="0,0,8,0" />
                    <Button Content="自动方案" Click="AutomationClick" Margin="0,0,8,0" />
                    <Button x:Name="AutomationPauseButton" Content="暂停自动" Click="AutomationPauseClick" Margin="0,0,8,0" />
                    <Button Content="任务栏设置" Click="TaskbarSettingsClick" Margin="0,0,8,0" />
                    <Button Content="显示源设置" Click="DisplaySourceSettingsClick" Margin="0,0,8,0" />
                    <Button Content="OSD 设置" Click="OsdSettingsClick" Margin="0,0,8,0" />
                    <CheckBox x:Name="TaskbarToggle" Content="显示任务栏状态" IsChecked="True" Checked="TaskbarToggleChanged" Unchecked="TaskbarToggleChanged" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="MiniProToolkit" FontSize="24" FontWeight="SemiBold" />
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,8,0,16">
                <TextBlock x:Name="StatusText" Foreground="#666" Text="正在读取硬件状态..." />
                <TextBlock x:Name="GuardianStatusText" Foreground="#666" FontSize="11" Margin="0,3,0,0" Text="Guardian: 检查中..." />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="方案:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="ProfileCombo" Width="150" DisplayMemberPath="Name" SelectionChanged="ProfileSelectionChanged" />
                    <Button Content="应用" Click="ApplyProfileClick" Margin="6,0,0,0" />
                    <Button Content="方案管理" Click="ManageProfilesClick" Margin="6,0,0,0" />
                    <Button Content="编辑曲线" Click="EditCurveClick" Margin="6,0,0,0" />
                    <Button Content="RPM 标定" Click="EditCalibrationClick" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="ProfileStatusText" Foreground="#555" TextWrapping="Wrap" Margin="0,5,0,0" Text="选择方案后点击应用；启动不会自动接管风扇。" />
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="性能模式" Margin="0,0,6,0">
                    <StackPanel>
                        <Button Content="静音" Click="SilenceClick" />
                        <Button Content="均衡" Click="BalanceClick" />
                        <Button Content="性能" Click="PerformanceClick" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="风扇" Margin="6,0">
                    <StackPanel>
                        <Button Content="EC 自动" Click="RestoreAutomaticClick" />
                        <Button Content="最大转速" Click="FullSpeedClick" />
                        <StackPanel Orientation="Horizontal" Margin="4,4,4,0">
                            <ComboBox x:Name="FixedRpmCombo" Width="96" SelectedIndex="1" IsEditable="True">
                                <ComboBoxItem Content="2100" />
                                <ComboBoxItem Content="2500" />
                                <ComboBoxItem Content="2800" />
                                <ComboBoxItem Content="3200" />
                                <ComboBoxItem Content="3500" />
                                <ComboBoxItem Content="4000" />
                            </ComboBox>
                            <Button Content="固定 RPM" Click="FixedRpmClick" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="CalibrationRangeText" FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="4,4,4,0" />
                        <TextBlock x:Name="CalibrationWarningText" FontSize="11" Foreground="DarkOrange" TextWrapping="Wrap" Margin="4,2" Visibility="Collapsed" />
                        <CheckBox x:Name="FanCurveToggle" Content="启用安全曲线" Margin="4,8,4,4" Checked="FanCurveToggleChanged" Unchecked="FanCurveToggleChanged" />
                        <TextBlock x:Name="CurvePreviewText" Text="曲线: 未启用" TextWrapping="Wrap" Margin="4,2,4,2" />
                        <TextBlock Text="需要 Guardian · 40% 起步 · 90°C 满速 · 升降速限制" Foreground="#666" FontSize="11" Margin="4,0" />
                        <TextBlock x:Name="CurveConfigText" Text="配置: 默认" Foreground="#666" FontSize="11" Margin="4,2" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Column="2" Header="实时状态" Margin="6,0,0,0">
                    <StackPanel Margin="8">
                        <TextBlock x:Name="TemperatureText" Text="CPU 温度: --" Margin="0,4" />
                        <TextBlock x:Name="FanText" Text="风扇: --" Margin="0,4" />
                        <TextBlock x:Name="ModeText" Text="模式: --" Margin="0,4" />
                        <TextBlock x:Name="UsageText" Text="占用: --" Margin="0,4" />
                        <TextBlock x:Name="MemoryText" Text="内存: --" Margin="0,4" />
                        <TextBlock x:Name="PowerText" Text="CPU 封装功耗（非整机）: -- W" Margin="0,4" />
                        <TextBlock x:Name="CpuFrequencyText" Text="CPU 频率: -- MHz" Margin="0,4" TextWrapping="Wrap" />
                        <TextBlock x:Name="CpuClassFrequencyText" Text="CPU 类别频率（只读）: 等待首次采样" Margin="0,4" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"
                                   ToolTip="来源：Windows CPU Set EfficiencyClass（Windows 效率等级 N）与 Processor Information\Processor Frequency；逻辑处理器 MHz 平均值及有效/预期样本，不是 APERF/MPERF 有效时钟，不推断 Intel P/E。仅显示/JSON 历史，不用于 EC 控制。" />
                        <TextBlock x:Name="LhmText" Text="LHM 对照: 等待首次采样" Margin="0,4" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                        <TextBlock x:Name="GpuText" Text="GPU（LHM 只读）: 等待首次采样" Margin="0,4" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                        <TextBlock x:Name="AuxTemperatureText" Text="主板/存储（LHM 只读）: Unknown，等待首次采样" Margin="0,4" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                        <TextBlock x:Name="DisplaySourceStatusText" Text="主显示源: --" Margin="0,4" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
            </Grid>
            <Border Grid.Row="3" Margin="0,14,0,0" Padding="10" Background="#F3F4F6" CornerRadius="4">
                <DockPanel>
                    <TextBlock x:Name="TrendLegendText" DockPanel.Dock="Top" Text="实时趋势（最近 2 分钟）  温度 ━  实际 RPM ━  目标 RPM - -  duty · ·  CPU 封装功耗 - -" Foreground="#4B5563" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <Canvas x:Name="TelemetryChart" Height="120" Background="White" SizeChanged="TelemetryChartSizeChanged" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
