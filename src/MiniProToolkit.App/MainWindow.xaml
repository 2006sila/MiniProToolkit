<Window x:Class="MiniProToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniProToolkit"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ObsidianWindowBackgroundBrush}"
        Foreground="{DynamicResource ObsidianTextPrimaryBrush}"
        FontFamily="{DynamicResource ObsidianFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Obsidian.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 侧栏导航图标：系统自带 Segoe Fluent Icons / Segoe MDL2 Assets（非 emoji、无外链字体） -->
            <FontFamily x:Key="ObsidianNavIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <Style x:Key="ObsidianNavIconStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ObsidianNavIconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>
            <Style x:Key="ObsidianNavTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <!-- 仅本窗口生效的 ToolTip 深色样式（不写进全局 App 资源，OSD/任务栏 overlay 不受影响） -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource ObsidianToolTipStyle}" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource ObsidianWindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧栏：品牌 + 导航 + 退出 ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource ObsidianSidebarBackgroundBrush}"
                BorderBrush="{StaticResource ObsidianSidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,18,14,12">
                    <TextBlock Text="MiniProToolkit" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource ObsidianTextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="BrandSubtitleText" Text="Lecoo MINI PRO-AHP · 单风扇 Fan1" FontSize="11"
                               Foreground="{StaticResource ObsidianTextTertiaryBrush}" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <Border x:Name="DashboardDemoPill" Visibility="Collapsed" Margin="0,8,0,0"
                            Background="{StaticResource ObsidianAccentSoftBrush}"
                            BorderBrush="{StaticResource ObsidianAccentBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8,3"
                            HorizontalAlignment="Left">
                        <TextBlock Text="演示数据（非实测）" FontSize="11"
                                   Foreground="{StaticResource ObsidianAccentBrush}" TextWrapping="Wrap" />
                    </Border>
                    <!-- 退出固定放侧栏顶部：工作区被高 DPI 压缩时也始终可见（沿用原 ExitClick） -->
                    <Button x:Name="ExitButton" Content="退出" Click="ExitClick" Margin="0,10,0,0"
                            Style="{StaticResource ObsidianButtonStyle}"
                            AutomationProperties.Name="退出程序" />
                    <TextBlock Text="退出程序并释放控制" FontSize="11"
                               Foreground="{StaticResource ObsidianTextTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <ScrollViewer Style="{StaticResource ObsidianScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8,0,8,0">
                    <StackPanel x:Name="NavPanel">
                        <Button x:Name="NavOverviewButton" Tag="active"
                                Style="{StaticResource ObsidianNavButtonStyle}" Click="OverviewClick"
                                AutomationProperties.Name="概览（滚动到顶部）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" Style="{StaticResource ObsidianNavIconStyle}" />
                                <TextBlock Text="概览" Style="{StaticResource ObsidianNavTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavProfilesButton"
                                Style="{StaticResource ObsidianNavButtonStyle}" Click="ManageProfilesClick"
                                AutomationProperties.Name="方案管理">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource ObsidianNavIconStyle}" />
                                <TextBlock Text="方案管理" Style="{StaticResource ObsidianNavTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavHistoryButton"
                                Style="{StaticResource ObsidianNavButtonStyle}" Click="HistoryClick"
                                AutomationProperties.Name="历史记录">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource ObsidianNavIconStyle}" />
                                <TextBlock Text="历史" Style="{StaticResource ObsidianNavTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDiagnosticsButton"
                                Style="{StaticResource ObsidianNavButtonStyle}" Click="DiagnosticsClick"
                                AutomationProperties.Name="诊断">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource ObsidianNavIconStyle}" />
                                <TextBlock Text="诊断" Style="{StaticResource ObsidianNavTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAutomationButton"
                                Style="{StaticResource ObsidianNavButtonStyle}" Click="AutomationClick"
                                AutomationProperties.Name="自动方案">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource ObsidianNavIconStyle}" />
                                <TextBlock Text="自动方案" Style="{StaticResource ObsidianNavTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTaskbarButton"
                                Style="{StaticResource ObsidianNavButtonStyle}" Click="TaskbarSettingsClick"
                                AutomationProperties.Name="任务栏设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C4;" Style="{StaticResource ObsidianNavIconStyle}" />
                                <TextBlock Text="任务栏" Style="{StaticResource ObsidianNavTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavFloatingButton"
                                Style="{StaticResource ObsidianNavButtonStyle}" Click="FloatingSettingsClick"
                                AutomationProperties.Name="悬浮窗设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource ObsidianNavIconStyle}" />
                                <TextBlock Text="悬浮窗" Style="{StaticResource ObsidianNavTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDisplaySourceButton"
                                Style="{StaticResource ObsidianNavButtonStyle}" Click="DisplaySourceSettingsClick"
                                AutomationProperties.Name="显示源设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource ObsidianNavIconStyle}" />
                                <TextBlock Text="显示源" Style="{StaticResource ObsidianNavTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavOsdButton"
                                Style="{StaticResource ObsidianNavButtonStyle}" Click="OsdSettingsClick"
                                AutomationProperties.Name="OSD 设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource ObsidianNavIconStyle}" />
                                <TextBlock Text="OSD" Style="{StaticResource ObsidianNavTextStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== 右侧主区：固定状态条 + 可滚动内容 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,10"
                    Background="{StaticResource ObsidianTopBarBackgroundBrush}"
                    BorderBrush="{StaticResource ObsidianDividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Row="0" Margin="0,0,0,6"
                               Text="正在读取硬件状态..."
                               Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                               Margin="0,0,0,6">
                        <Button x:Name="RestoreAutomaticButton" Content="恢复 EC 自动" Margin="0,0,8,0"
                                Click="RestoreAutomaticClick"
                                Style="{StaticResource ObsidianPrimaryButtonStyle}"
                                AutomationProperties.Name="恢复 EC 自动"
                                ToolTip="请求 EC 自动并释放本程序占用；EC 自动模式本身不可回读。" />
                        <Button x:Name="FullSpeedButton" Content="满速" Click="FullSpeedClick"
                                Style="{StaticResource ObsidianDangerButtonStyle}"
                                AutomationProperties.Name="风扇满速"
                                ToolTip="请求风扇满速（duty 100%）。需要 Guardian 与有效租约。" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="2" Orientation="Horizontal">
                        <Border Style="{StaticResource ObsidianPillStyle}"
                                ToolTip="Guardian 状态来自原有服务检测；演示标识不代表实机健康验收。">
                            <TextBlock x:Name="GuardianStatusText" Text="Guardian: 检查中..." FontSize="12"
                                       Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource ObsidianPillStyle}"
                                ToolTip="控制归属来自最近一次读取；按钮点击不代表硬件写入成功。">
                            <TextBlock x:Name="DashboardEcPillText" Text="控制归属: --" FontSize="12"
                                       Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Button x:Name="AutomationPauseButton" Content="暂停自动" Margin="0,0,8,0"
                                Click="AutomationPauseClick"
                                Style="{StaticResource ObsidianButtonStyle}"
                                AutomationProperties.Name="暂停或恢复方案自动切换" />
                        <!-- 显示任务栏状态的开关只存在于左侧导航栏「任务栏」打开的设置窗口（TaskbarSettingsWindow），
                             概览不再有状态卡；桌面悬浮窗的启用与完整设置都在悬浮窗设置窗口里。
                             顶栏只保留 Guardian/EC 归属与暂停自动，窗口变窄或高 DPI 放大时不会被横向挤掉。 -->
                    </WrapPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1"
                          Style="{StaticResource ObsidianScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="16,12,10,16">
                <!-- 工作区小于 980x620 DIP 时允许水平滚动到风扇卡，而不是硬裁切；
                     正常 980 px 及以上不会出现横条（724 + 侧栏 180 + 内边距 < 980）。 -->
                <StackPanel MinWidth="724">

                    <!-- 主视觉：大字号温度 + 四项等宽指标（同一条横向指标带） -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 左列固定 220：只保留 CPU 温度卡作为概览主视觉。
                             任务栏状态条的开关在「任务栏」设置窗口，悬浮窗开关在悬浮窗设置窗口，概览不重复提供。 -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                        <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CPU 温度" Style="{StaticResource ObsidianMetricLabelStyle}"
                                               FontSize="13" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock x:Name="DashboardTemperatureValue" Text="--"
                                                   Style="{StaticResource ObsidianDisplayValueStyle}"
                                                   AutomationProperties.Name="CPU 温度大数字" />
                                        <TextBlock x:Name="DashboardTemperatureUnit" Text="°C" FontSize="18"
                                                   Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                                   VerticalAlignment="Bottom" Margin="6,0,0,8" />
                                    </StackPanel>
                                    <ProgressBar x:Name="DashboardTemperatureBar" Maximum="100" Value="0"
                                                 Style="{StaticResource ObsidianProgressBarStyle}"
                                                 Margin="0,2,0,8"
                                                 AutomationProperties.Name="CPU 温度刻度（0-100 °C，满速阈值 90 °C）" />
                                    <TextBlock x:Name="DashboardTemperatureSourceText"
                                               Text="显示源 -- · 风扇控制使用原始 EC 温度"
                                               Style="{StaticResource ObsidianCaptionTextStyle}" />
                                    <TextBlock x:Name="DashboardTemperatureNoteText"
                                               Text="90 °C 触发满速保护 · 启动不自动接管风扇"
                                               Style="{StaticResource ObsidianSecondaryTextStyle}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                        <!-- 概览不再有「状态条启用」卡：任务栏状态条的唯一开关是任务栏设置窗口的
                             「显示任务栏状态」，桌面悬浮窗的唯一开关是悬浮窗设置窗口的「启用桌面悬浮窗」。 -->
                        </StackPanel>

                        <!-- 四列等宽（* 列）而非内容宽度，980 px 下不会被内容撑出水平溢出 -->
                        <Grid Grid.Column="1" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="风扇" Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="DashboardFanValue" Text="--"
                                                   Style="{StaticResource ObsidianMetricValueStyle}"
                                                   AutomationProperties.Name="风扇转速" />
                                        <TextBlock x:Name="DashboardFanUnit" Text="RPM" FontSize="11"
                                                   Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                                   VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Text="Fan1 实际转速" TextWrapping="Wrap"
                                               Style="{StaticResource ObsidianCaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ObsidianCardStyle}" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CPU 封装功耗" TextWrapping="Wrap"
                                               Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="DashboardPowerValue" Text="--"
                                                   Style="{StaticResource ObsidianMetricValueStyle}"
                                                   AutomationProperties.Name="CPU 封装功耗" />
                                        <TextBlock x:Name="DashboardPowerUnit" Text="W" FontSize="11"
                                                   Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                                   VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Text="非整机功耗" TextWrapping="Wrap"
                                               Style="{StaticResource ObsidianCaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource ObsidianCardStyle}" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CPU 占用" TextWrapping="Wrap"
                                               Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="DashboardUsageValue" Text="--"
                                                   Style="{StaticResource ObsidianMetricValueStyle}"
                                                   AutomationProperties.Name="CPU 占用率" />
                                        <TextBlock x:Name="DashboardUsageUnit" Text="%" FontSize="11"
                                                   Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                                   VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Text="系统计数平均值" TextWrapping="Wrap"
                                               Style="{StaticResource ObsidianCaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource ObsidianCardStyle}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="CPU 频率" TextWrapping="Wrap"
                                               Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="DashboardFrequencyValue" Text="--"
                                                   Style="{StaticResource ObsidianMetricValueStyle}"
                                                   AutomationProperties.Name="CPU 频率" />
                                        <TextBlock x:Name="DashboardFrequencyUnit" Text="MHz" FontSize="11"
                                                   Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                                   VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Text="只读采样" TextWrapping="Wrap"
                                               Style="{StaticResource ObsidianCaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 趋势 + 风扇控制 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="280" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="实时趋势" Style="{StaticResource ObsidianSectionHeaderStyle}" />
                                    <TextBlock Grid.Column="1" Text="最近 2 分钟"
                                               Style="{StaticResource ObsidianCaptionTextStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="TrendLegendText" Grid.Row="1"
                                           Text="实时趋势（最近 2 分钟）  温度 ━  实际 RPM ━  目标 RPM - -  duty · ·  CPU 封装功耗 - -"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,8"
                                           Foreground="{StaticResource ObsidianTextSecondaryBrush}" />
                                <Border Grid.Row="2" Background="{StaticResource ObsidianChartBackgroundBrush}"
                                        BorderBrush="{StaticResource ObsidianDividerBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="6" MinHeight="150">
                                    <Canvas x:Name="TelemetryChart" Height="150"
                                            Background="Transparent" ClipToBounds="True"
                                            SizeChanged="TelemetryChartSizeChanged" />
                                </Border>
                                <TextBlock Grid.Row="3" Margin="0,8,0,0"
                                           Text="各指标独立归一化后同图绘制（温度 30–100 °C、RPM 0–4500、duty 0–100%、功耗 0–80 W），不共用物理刻度，不合成单轴读数。"
                                           Style="{StaticResource ObsidianCaptionTextStyle}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ObsidianCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="风扇控制" Style="{StaticResource ObsidianSectionHeaderStyle}"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource ObsidianPillStyle}"
                                            HorizontalAlignment="Right">
                                        <TextBlock x:Name="DashboardFanRequestText" Text="控制归属: --"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ObsidianTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="EC 自动" Click="RestoreAutomaticClick" Margin="0,0,8,6"
                                            Style="{StaticResource ObsidianPrimaryButtonStyle}"
                                            AutomationProperties.Name="请求 EC 自动" />
                                    <Button Content="满速" Click="FullSpeedClick" Margin="0,0,8,6"
                                            Style="{StaticResource ObsidianDangerButtonStyle}"
                                            AutomationProperties.Name="请求风扇满速" />
                                </WrapPanel>
                                <TextBlock Text="固定 RPM" Style="{StaticResource ObsidianMetricLabelStyle}"
                                           Margin="0,4,0,4" />
                                <WrapPanel>
                                    <ComboBox x:Name="FixedRpmCombo" Width="112" IsEditable="True"
                                              SelectedIndex="1"
                                              Style="{StaticResource ObsidianComboBoxStyle}"
                                              AutomationProperties.Name="固定 RPM 目标值">
                                        <ComboBoxItem Content="2100" />
                                        <ComboBoxItem Content="2500" />
                                        <ComboBoxItem Content="2800" />
                                        <ComboBoxItem Content="3200" />
                                        <ComboBoxItem Content="3500" />
                                        <ComboBoxItem Content="4000" />
                                    </ComboBox>
                                    <Button Content="固定 RPM" Click="FixedRpmClick" Margin="8,0,0,0"
                                            Style="{StaticResource ObsidianButtonStyle}"
                                            AutomationProperties.Name="应用固定 RPM" />
                                </WrapPanel>
                                <TextBlock x:Name="CalibrationRangeText"
                                           Style="{StaticResource ObsidianCaptionTextStyle}" Margin="0,6,0,0" />
                                <TextBlock x:Name="CalibrationWarningText" Visibility="Collapsed"
                                           Foreground="{StaticResource ObsidianWarningBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                <CheckBox x:Name="FanCurveToggle" Content="启用安全曲线"
                                          Checked="FanCurveToggleChanged" Unchecked="FanCurveToggleChanged"
                                          Style="{StaticResource ObsidianCheckBoxStyle}" Margin="0,8,0,4"
                                          AutomationProperties.Name="启用安全曲线" />
                                <TextBlock x:Name="CurvePreviewText" Text="曲线: 未启用"
                                           Style="{StaticResource ObsidianSecondaryTextStyle}" />
                                <TextBlock Text="需要 Guardian · 40% 起步 · 90°C 满速 · 升降速限制"
                                           Style="{StaticResource ObsidianCaptionTextStyle}" Margin="0,4,0,0" />
                                <TextBlock x:Name="CurveConfigText" Text="配置: 默认"
                                           Style="{StaticResource ObsidianCaptionTextStyle}" Margin="0,4,0,0" />
                                <Border Height="1" Background="{StaticResource ObsidianDividerBrush}" Margin="0,10" />
                                <TextBlock Text="风扇读数与请求归属" Style="{StaticResource ObsidianMetricLabelStyle}" />
                                <TextBlock x:Name="FanText" Text="风扇: --"
                                           Style="{StaticResource ObsidianSecondaryTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 性能模式 -->
                    <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="性能模式" Style="{StaticResource ObsidianSectionHeaderStyle}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border Background="{StaticResource ObsidianTopBarBackgroundBrush}" BorderBrush="{StaticResource ObsidianDividerBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SilenceModeButton" Content="静音" Click="SilenceClick"
                                                Style="{StaticResource ObsidianSegmentButtonStyle}"
                                                AutomationProperties.Name="静音模式" />
                                        <Button x:Name="BalanceModeButton" Content="均衡" Click="BalanceClick"
                                                Style="{StaticResource ObsidianSegmentButtonStyle}"
                                                AutomationProperties.Name="均衡模式" />
                                        <Button x:Name="PerformanceModeButton" Content="性能" Click="PerformanceClick"
                                                Style="{StaticResource ObsidianSegmentButtonStyle}"
                                                AutomationProperties.Name="性能模式" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="ModeText" Text="模式: --"
                                           Style="{StaticResource ObsidianSecondaryTextStyle}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" TextWrapping="Wrap"
                                       Text="选中态来自最近一次读取到的模式，不代表写入成功"
                                       Style="{StaticResource ObsidianCaptionTextStyle}" />
                        </Grid>
                    </Border>

                    <!-- 方案 -->
                    <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="方案" Style="{StaticResource ObsidianSectionHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="启动不自动接管；应用需要显式点击"
                                           Style="{StaticResource ObsidianCaptionTextStyle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    <TextBlock Text="方案" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{StaticResource ObsidianTextSecondaryBrush}" />
                                    <ComboBox x:Name="ProfileCombo" Width="180"
                                              Style="{StaticResource ObsidianComboBoxStyle}"
                                              DisplayMemberPath="Name"
                                              TextSearch.TextPath="Name"
                                              SelectionChanged="ProfileSelectionChanged"
                                              AutomationProperties.Name="方案选择" />
                                </StackPanel>
                                <Button Content="应用" Click="ApplyProfileClick" Margin="0,0,8,6"
                                        Style="{StaticResource ObsidianPrimaryButtonStyle}"
                                        AutomationProperties.Name="应用方案" />
                                <Button Content="方案管理" Click="ManageProfilesClick" Margin="0,0,8,6"
                                        Style="{StaticResource ObsidianButtonStyle}"
                                        AutomationProperties.Name="方案管理" />
                                <Button Content="编辑曲线" Click="EditCurveClick" Margin="0,0,8,6"
                                        Style="{StaticResource ObsidianButtonStyle}"
                                        AutomationProperties.Name="编辑风扇曲线" />
                                <Button Content="RPM 标定" Click="EditCalibrationClick" Margin="0,0,8,6"
                                        Style="{StaticResource ObsidianButtonStyle}"
                                        AutomationProperties.Name="RPM 标定" />
                            </WrapPanel>
                            <TextBlock x:Name="ProfileStatusText"
                                       Text="选择方案后点击应用；启动不会自动接管风扇。"
                                       Style="{StaticResource ObsidianSecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 采样详情（旧标签整句原文，不占主卡） -->
                    <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
                        <Expander Style="{StaticResource ObsidianExpanderStyle}" IsExpanded="False"
                                  Header="采样详情（原始标签文本）">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TemperatureText" Text="CPU 温度: --"
                                           Style="{StaticResource ObsidianSecondaryTextStyle}"
                                           Margin="0,0,12,8" />
                                <TextBlock x:Name="PowerText" Grid.Column="1" Text="CPU 封装功耗（非整机）: -- W"
                                           Style="{StaticResource ObsidianSecondaryTextStyle}"
                                           Margin="0,0,12,8" />
                                <TextBlock x:Name="UsageText" Text="占用: --"
                                           Style="{StaticResource ObsidianSecondaryTextStyle}"
                                           Margin="0,0,12,8" />
                                <TextBlock x:Name="CpuFrequencyText" Grid.Column="1" Text="CPU 频率: -- MHz"
                                           Style="{StaticResource ObsidianSecondaryTextStyle}"
                                           Margin="0,0,12,8" />
                            </Grid>
                        </Expander>
                    </Border>

                    <!-- 只读监测 -->
                    <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,4">
                        <Expander Style="{StaticResource ObsidianExpanderStyle}" IsExpanded="True"
                                  Header="只读监测与显示源（不影响风扇控制）">
                            <WrapPanel>
                                <StackPanel MinWidth="220" Margin="0,0,24,10">
                                    <TextBlock Text="内存占用" Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <TextBlock x:Name="MemoryText" Text="内存: --"
                                               Style="{StaticResource ObsidianSecondaryTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel MinWidth="220" Margin="0,0,24,10">
                                    <TextBlock Text="CPU 类别频率（只读）"
                                               Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <TextBlock x:Name="CpuClassFrequencyText"
                                               Text="CPU 类别频率（只读）: 等待首次采样"
                                               Style="{StaticResource ObsidianSecondaryTextStyle}" Margin="0,2,0,0"
                                               ToolTip="来源：Windows CPU Set EfficiencyClass（Windows 效率等级 N）与 Processor Information\Processor Frequency；逻辑处理器 MHz 平均值及有效/预期样本，不是 APERF/MPERF 有效时钟，不推断 Intel P/E。仅显示/JSON 历史，不用于 EC 控制。" />
                                </StackPanel>
                                <StackPanel MinWidth="220" Margin="0,0,24,10">
                                    <TextBlock Text="LHM 对照（只读）"
                                               Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <TextBlock x:Name="LhmText" Text="LHM 对照: 等待首次采样"
                                               Style="{StaticResource ObsidianSecondaryTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel MinWidth="220" Margin="0,0,24,10">
                                    <TextBlock Text="GPU（只读）" Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <TextBlock x:Name="GpuText" Text="GPU（LHM 只读）: 等待首次采样"
                                               Style="{StaticResource ObsidianSecondaryTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel MinWidth="220" Margin="0,0,24,10">
                                    <TextBlock Text="主板 / 存储（只读）"
                                               Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <TextBlock x:Name="AuxTemperatureText"
                                               Text="主板/存储（LHM 只读）: Unknown，等待首次采样"
                                               Style="{StaticResource ObsidianSecondaryTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel MinWidth="240" Margin="0,0,24,10">
                                    <TextBlock Text="主显示源" Style="{StaticResource ObsidianMetricLabelStyle}" />
                                    <TextBlock x:Name="DisplaySourceStatusText" Text="主显示源: --"
                                               Style="{StaticResource ObsidianSecondaryTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </WrapPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
