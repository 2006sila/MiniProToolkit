<Window x:Class="MiniProToolkit.App.TaskbarStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Background="#202124"
        SizeToContent="WidthAndHeight">
    <Border x:Name="RootBorder" Padding="6,1" Background="#202124">
        <StackPanel x:Name="StatusPanel" Orientation="Horizontal">
            <TextBlock x:Name="StatusText"
                       Foreground="#E8EAED"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Text="CPU --°C | Fan ---- RPM | --" />
        </StackPanel>
    </Border>
</Window>
