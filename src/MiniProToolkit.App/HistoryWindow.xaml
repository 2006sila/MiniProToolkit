<Window x:Class="MiniProToolkit.App.HistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="历史与事件" Width="1080" Height="760" MinWidth="880" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{DynamicResource ObsidianWindowBackgroundBrush}"
        Foreground="{DynamicResource ObsidianTextPrimaryBrush}"
        FontFamily="{DynamicResource ObsidianFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 方案 A「曜石控制舱」共用皮肤：基础色 + 键控样式 + 仅在本窗口生效的隐式控件样式。
                     只在当前窗口合并，不写进 App.xaml 全局资源，避免污染 OSD / 任务栏 overlay 的用户自定义视觉。 -->
                <ResourceDictionary Source="Themes/Obsidian.Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="历史与事件" FontSize="22" FontWeight="SemiBold"/>
   <WrapPanel Margin="0,8">
    <Button Content="刷新本机历史" Click="ReloadClick"/><Button Content="打开 JSONL 文件" Click="OpenClick"/>
    <Button Content="导出所选时段" Click="ExportRecordsClick"/><Button Content="导出筛选事件" Click="ExportEventsClick"/>
   </WrapPanel>
   <WrapPanel Margin="0,0,0,8">
    <TextBlock Text="起始（本地时间）" VerticalAlignment="Center"/><TextBox x:Name="FromText" AutomationProperties.Name="历史起始本地时间" Width="155" Margin="6,0,12,0"/>
    <TextBlock Text="结束" VerticalAlignment="Center"/><TextBox x:Name="ToText" AutomationProperties.Name="历史结束本地时间" Width="155" Margin="6,0,12,0"/>
    <Button Content="筛选" Click="FilterClick"/><Button Content="全部时间" Click="AllClick"/>
   </WrapPanel>
   <WrapPanel Margin="0,0,0,6">
    <TextBlock Text="归档份数 1–30" VerticalAlignment="Center"/><TextBox x:Name="RetainedText" AutomationProperties.Name="历史归档保留份数" Width="40" Margin="6,0,10,0"/>
    <TextBlock Text="单文件 MiB 1–100" VerticalAlignment="Center"/><TextBox x:Name="MaxBytesText" AutomationProperties.Name="历史单文件最大 MiB" Width="45" Margin="6,0,10,0"/>
    <TextBlock Text="归档年龄天数 1–365（留空关闭）" VerticalAlignment="Center"/><TextBox x:Name="MaxAgeText" AutomationProperties.Name="历史归档最大年龄天数 留空关闭" Width="45" Margin="6,0,10,0"/>
    <Button Content="保存保留设置" Click="SaveRetentionClick"/><Button Content="预览并清理归档" Click="CleanupClick"/>
   </WrapPanel>
   <TextBlock Text="保留设置仅影响后续写入（最多 60 秒刷新）；年龄按归档文件修改时间，不逐行删除。活跃文件和 schema 备份不清理。" FontSize="11" Foreground="{StaticResource ObsidianTextSecondaryBrush}" TextWrapping="Wrap"/>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource ObsidianTextSecondaryBrush}" Margin="0,0,0,8"/>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="不访问硬件。清理须预览并确认，仅删除符合规则的历史归档。导出内容为所选时段的数据或筛选后的事件；事件文本可能含本地路径，请按需检查后分享。GPU 温度（LHM 只读）为 JSONL 追加字段：采样表可看，CSV 导出表头不变，因此 CSV 不含 GPU 列。主板/存储温度同为可选 JSONL 只读列，Unknown 表示无可用读数，不影响 EC 风扇控制。" Foreground="{StaticResource ObsidianTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <TabControl>
   <TabItem Header="趋势与采样">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="300"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel>
      <Button Content="放大" Click="ZoomInClick"/><Button Content="缩小" Click="ZoomOutClick"/><Button Content="全时段" Click="ResetZoomClick"/>
      <ComboBox x:Name="TemperatureUnitCombo" AutomationProperties.Name="历史图温度单位" SelectedIndex="0" Width="65" SelectionChanged="UnitChanged"><ComboBoxItem Content="°C"/><ComboBoxItem Content="°F"/></ComboBox>
      <CheckBox x:Name="TempCheck" Content="温度" IsChecked="True" Margin="8" Click="SeriesChanged"/>
      <CheckBox x:Name="RpmCheck" Content="实际 RPM" IsChecked="True" Margin="8" Click="SeriesChanged"/>
      <CheckBox x:Name="TargetCheck" Content="目标 RPM" IsChecked="True" Margin="8" Click="SeriesChanged"/>
      <CheckBox x:Name="DutyCheck" Content="duty" IsChecked="True" Margin="8" Click="SeriesChanged"/>
      <CheckBox x:Name="CpuCheck" Content="CPU 占用" IsChecked="True" Margin="8" Click="SeriesChanged"/>
      <CheckBox x:Name="PowerCheck" Content="CPU 功耗（W）" IsChecked="True" Margin="8" Click="SeriesChanged"/>
     </WrapPanel>
     <Border Grid.Row="1" Background="{StaticResource ObsidianChartBackgroundBrush}" BorderBrush="{StaticResource ObsidianCardBorderBrush}" BorderThickness="1"><Canvas x:Name="Chart" SizeChanged="ChartChanged" ClipToBounds="True"/></Border>
     <StackPanel Grid.Row="2"><TextBlock x:Name="RangeText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource ObsidianTextSecondaryBrush}" Margin="0,4"/><Slider x:Name="PanSlider" Minimum="0" Maximum="1" ValueChanged="PanChanged"/></StackPanel>
     <DataGrid Grid.Row="3" x:Name="SamplesGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="190"/>
       <DataGridTextColumn Header="EC °C" Binding="{Binding CpuTemperatureC}"/>
       <DataGridTextColumn Header="显示 °C" Binding="{Binding EffectiveDisplayCpuTemperatureC}"/>
       <DataGridTextColumn Header="实际 RPM" Binding="{Binding Fan1Rpm}"/>
       <DataGridTextColumn Header="目标 RPM" Binding="{Binding TargetRpm}"/>
       <DataGridTextColumn Header="曲线目标 RPM（JSONL）" Binding="{Binding CurveTargetRpm}"/>
       <DataGridTextColumn Header="曲线实际 RPM" Binding="{Binding CurveActualRpm}"/>
       <DataGridTextColumn Header="曲线误差 RPM" Binding="{Binding CurveRpmError}"/>
       <DataGridTextColumn Header="曲线跟踪态（JSONL）" Binding="{Binding CurveTrackingState}"/>
       <DataGridTextColumn Header="Duty %" Binding="{Binding TargetDuty}"/>
       <DataGridTextColumn Header="CPU %" Binding="{Binding CpuUsagePercent}"/>
       <DataGridTextColumn Header="Energy Meter W" Binding="{Binding CpuPackagePowerWatts}"/>
       <DataGridTextColumn Header="显示功耗 W" Binding="{Binding EffectiveDisplayCpuPackagePowerWatts}"/>
       <DataGridTextColumn Header="LHM 温度 °C" Binding="{Binding LhmCpuPackageTemperatureC}"/>
       <DataGridTextColumn Header="LHM 功耗 W" Binding="{Binding LhmCpuPackagePowerWatts}"/>
       <DataGridTextColumn Header="GPU °C（LHM 只读）" Binding="{Binding GpuTemperatureC}">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock">
          <Setter Property="ToolTip" Value="{Binding GpuSensorName}"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="GPU 传感器/状态" Binding="{Binding GpuSensorStatus}" Width="200"/>
       <DataGridTextColumn Header="主板 °C（只读）" Binding="{Binding MotherboardTemperatureC, TargetNullValue=Unknown}"/>
       <DataGridTextColumn Header="主板传感器" Binding="{Binding MotherboardTemperatureSensorName}"/>
       <DataGridTextColumn Header="存储 °C（NVMe/SATA 只读）" Binding="{Binding StorageTemperatureC, TargetNullValue=Unknown}"/>
       <DataGridTextColumn Header="存储传感器" Binding="{Binding StorageTemperatureSensorName}"/>
       <DataGridTextColumn Header="辅助温度状态（JSONL）" Binding="{Binding AuxTemperatureStatus}" Width="200"/>
       <DataGridTextColumn Header="显示源" Binding="{Binding DisplayCpuSource}"/>
       <DataGridTextColumn Header="显示提示" Binding="{Binding DisplaySourceStatus}" Width="160"/>
       <DataGridTextColumn Header="CPU MHz" Binding="{Binding CpuFrequencyMhz}"/>
       <DataGridTextColumn Header="CPU 类别频率（JSONL 只读）" Binding="{Binding CpuClassFrequencyText}" Width="360">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock">
          <Setter Property="ToolTip" Value="来源：Windows CPU Set EfficiencyClass 与 Processor Information\Processor Frequency；Windows 效率等级 N 的逻辑处理器平均 MHz、有效/预期样本。非 APERF/MPERF 有效时钟，不推断 Intel P/E，不参与 EC 控制；旧记录不可用，CSV 31 列不变。"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="CPU 基准 %" Binding="{Binding CpuFrequencyPercentOfBase}"/>
       <DataGridTextColumn Header="频率提示" Binding="{Binding CpuFrequencyStatus}" Width="160"/>
       <DataGridTextColumn Header="模式" Binding="{Binding PowerMode}"/>
       <DataGridTextColumn Header="错误/保护" Binding="{Binding FanFault}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="事件中心">
    <DockPanel Margin="8">
     <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="类别" VerticalAlignment="Center"/><ComboBox x:Name="KindCombo" AutomationProperties.Name="历史事件类别" Width="120" SelectedIndex="0" SelectionChanged="EventFilterChanged">
       <ComboBoxItem Content="全部"/><ComboBoxItem Content="错误/保护"/><ComboBoxItem Content="恢复"/><ComboBoxItem Content="模式"/><ComboBoxItem Content="控制/方案"/>
      </ComboBox>
      <TextBlock Text="关键词" Margin="12,0,6,0" VerticalAlignment="Center"/><TextBox x:Name="SearchText" AutomationProperties.Name="历史事件关键词" Width="250" TextChanged="SearchChanged"/>
     </WrapPanel>
     <DataGrid x:Name="EventsGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="190"/><DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="80"/>
       <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80"/><DataGridTextColumn Header="事件" Binding="{Binding Message}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
