<Window x:Class="MiniProToolkit.App.FanCalibrationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="风扇 RPM 标定"
        Width="720"
        Height="500"
        MinWidth="680"
        MinHeight="400"
        WindowStartupLocation="CenterOwner" Closing="EditorClosing">
    <DockPanel Margin="14">
        <StackPanel x:Name="EditButtons" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="添加点" Click="AddPointClick" Margin="0,0,6,0" />
            <Button Content="删除点" Click="RemovePointClick" Margin="0,0,6,0" />
            <Button Content="导入" Click="ImportClick" Margin="0,0,6,0" />
            <Button Content="导出" Click="ExportClick" Margin="0,0,6,0" />
            <Button Content="恢复默认" Click="ResetClick" Margin="0,0,6,0" />
            <Button x:Name="CancelButton" Content="取消" Click="CancelClick" Margin="0,0,6,0" />
            <Button Content="保存" Click="SaveClick" IsDefault="True" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="请低负载、低温运行：起始原始 EC 温度须 0&lt;T&lt;65°C，过程须 0&lt;T&lt;70°C；达到 70°C 立即取消并恢复自动。实测会短暂控制单风扇 40%–100% duty（最长 4 分钟）。原草稿保留；成功恢复 EC 自动后才替换草稿，仍须手动保存。" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                <Button x:Name="StartSamplingButton" Content="开始自动实测" Click="StartSamplingClick" Margin="0,0,8,0" />
                <Button x:Name="CancelSamplingButton" Content="取消实测并恢复自动" Click="CancelSamplingClick" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="SamplingStatusText" TextWrapping="Wrap" Foreground="#4B5563" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="110" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="风扇 duty/RPM 标定" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="输入实测 duty 与 RPM。duty 必须严格递增、覆盖 40%–100%，RPM 必须不下降。只有点击“开始自动实测”才控制风扇；导入、重置或实测后需保存才会应用标定。"
                       Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,12" />
            <TextBlock Grid.Row="2" x:Name="RangeText" Foreground="#4B5563" Margin="0,0,0,8" TextWrapping="Wrap" />
            <Border Grid.Row="3" Background="#F3F4F6" Margin="0,0,0,8" ClipToBounds="True">
                <Canvas x:Name="PreviewCanvas" SizeChanged="PreviewSizeChanged" />
            </Border>
            <DataGrid Grid.Row="4" x:Name="PointsGrid" CanUserSortColumns="False" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Duty %" Binding="{Binding DutyPercent, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="实际 RPM" Binding="{Binding Rpm, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="插值说明" IsReadOnly="True" Binding="{Binding Description}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
